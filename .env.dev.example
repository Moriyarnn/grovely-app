PORT=3000

# ── Accounts ─────────────────────────────────────────────────────────────────
# Two household accounts created on first run.
OWNER1_USERNAME=dev
OWNER1_PASSWORD=dev

OWNER2_USERNAME=dev2
OWNER2_PASSWORD=dev2

# ── License (optional) ────────────────────────────────────────────────────────
# Unlocks premium features. Get a key at https://grovely.lemonsqueezy.com
# Leave blank to run in free-tier mode.
# LICENSE_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# JWT_SECRET=your-secret-here

# ── Email notifications (premium) ────────────────────────────────────────────
# Email is disabled by default in dev. Set DISABLE_EMAIL=false and fill in
# SMTP credentials if you want to test notification sending locally.
DISABLE_EMAIL=true

# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=you@example.com
# MAIL_PASSWORD=your-app-password
# ACCOUNT1_EMAIL=you@example.com
# ACCOUNT2_EMAIL=partner@example.com
