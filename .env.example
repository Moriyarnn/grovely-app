# Docker Compose environment variables
# Copy this file to .env and adjust as needed.
# These are read by Docker Compose for variable substitution — they are not
# passed into the container directly. App configuration lives in
# grovely-backend/.env (copy from grovely-backend/.env.example).

# ── Timezone ──────────────────────────────────────────────────────────────────
# Set to your local timezone so the notification cron fires at the right time.
# Find your timezone string at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Santiago
TZ=UTC

# ── User / Group ID ───────────────────────────────────────────────────────────
# Run the container as your host user so data volume files are owned by you,
# not root. Find your IDs by running: id
# (Most Linux systems default to 1000/1000 for the first non-root user.)
PUID=1000
PGID=1000

# ── Reverse Proxy Network (optional) ──────────────────────────────────────────
# Only used with docker-compose.proxy-docker.yml (containerized reverse proxy).
# Default is "proxy". Override if your existing shared network has a different
# name (e.g. "web", "traefik", "caddy_net"). Create the network once:
#   docker network create proxy
PROXY_NETWORK=proxy
