# Grovely configuration
# Copy this file to `.env` (in the same folder as docker-compose.yml) and
# fill in the values. Everything Grovely reads lives in this one file.

# ── Accounts (required) ──────────────────────────────────────────────────────
# Two household accounts created on first run. Changing these after first run
# has no effect — the accounts are seeded once into the database on startup.
# To change credentials later, update them inside the app (Settings).
#
# owner1: full access — period tracker read/write, settings, all household features.
# owner2: shared household access (pantry, settings) + read-only period data.
#         Cannot log, edit, or delete period cycles.
OWNER1_USERNAME=your_username
OWNER1_PASSWORD=change_me

OWNER2_USERNAME=partner_username
OWNER2_PASSWORD=change_me

# ── License (optional, unlocks premium features) ─────────────────────────────
# Unlocks premium features for the whole household (owner + partner).
# Get a key at https://grovely.lemonsqueezy.com — leave blank to run in free-tier mode.
# LICENSE_KEY=

# ── Timezone ─────────────────────────────────────────────────────────────────
# Set to your local timezone so the notification cron fires at the right time.
# Find your timezone string at:
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Santiago
TZ=UTC

# ── User / Group ID ──────────────────────────────────────────────────────────
# Run the container as your host user so data volume files are owned by you,
# not root. Find your IDs by running: id
# (Most Linux systems default to 1000/1000 for the first non-root user.)
PUID=1000
PGID=1000

# ── Reverse Proxy Network (only used with docker-compose.proxy-docker.yml) ───
# Default is "proxy". Override if your existing shared network has a different
# name (e.g. "web", "traefik", "caddy_net"). Create the network once:
#   docker network create proxy
PROXY_NETWORK=proxy

# ── Security (optional) ──────────────────────────────────────────────────────
# JWT secret for signing auth tokens. Auto-generated on first run and saved to
# data/secret.key — you don't need to set this manually. Only set it if you
# want to control the secret yourself (e.g. key rotation, multi-instance sync).
# JWT_SECRET=your-secret-here
#
# Private notes are encrypted at rest with a separate key auto-generated at
# data/encryption.key. Like data/secret.key it is never included in backups, so
# if you move to a new server copy the data/ folder across or your encrypted
# notes will not be readable. There is nothing to configure here.

# ── Email notifications (premium) ────────────────────────────────────────────
# All 15 notification types are a premium feature — a valid LICENSE_KEY is
# required for any email to send. Without a license the cron runs but exits
# early without sending anything.
#
# Set DISABLE_EMAIL=true to stop all email sending entirely (useful during
# setup or if you don't want notifications at all).
#
# Works with any SMTP provider: Gmail, Outlook, Fastmail, self-hosted, etc.
# MAIL_PORT defaults to 587 (STARTTLS). Use 465 with MAIL_SECURE=true for SSL.
#
# Gmail: generate an App Password at
#   Google Account → Security → 2-Step Verification → App Passwords
#
# ACCOUNT1_EMAIL: where owner1 receives period, fertile window, and pantry alerts.
# ACCOUNT2_EMAIL: where owner2 (partner) receives partner-facing notifications.
#                 Optional — leave blank if you only want owner1 notifications.

DISABLE_EMAIL=false

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# MAIL_SECURE=true        # uncomment if using port 465
MAIL_USER=you@example.com
MAIL_PASSWORD=your-app-password

ACCOUNT1_EMAIL=you@example.com
# ACCOUNT2_EMAIL=partner@example.com

# ── Backups (premium, optional) ──────────────────────────────────────────────
# Backup schedule and retention are configured in-app under Settings.
# The variables below control where backup files are stored.
#
# BACKUP_DIR: where local snapshot files are written.
#   Defaults to data/backups inside the existing data volume.
#   Point this at a separate mounted volume to keep backups isolated.
# BACKUP_DIR=/data/backups

# S3-compatible storage (AWS S3, Backblaze B2, Cloudflare R2, Wasabi, MinIO…)
# All five vars are required to activate this target.
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_BUCKET=my-grovely-backups
# BACKUP_S3_KEY=your-access-key-id
# BACKUP_S3_SECRET=your-secret-access-key
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=

# WebDAV (Nextcloud, ownCloud, Synology, QNAP, TrueNAS, Apache mod_dav…)
# URL should point at the directory where snapshots will be uploaded.
# BACKUP_WEBDAV_URL=https://nextcloud.example.com/remote.php/dav/files/you/grovely-backups
# BACKUP_WEBDAV_USER=your-username
# BACKUP_WEBDAV_PASS=your-app-password
